<script>
  (function () {
    var revealed = false

    function revealIntro() {
      if (revealed) return
      revealed = true

      var introTitle = document.querySelector('.intro-title')
      var introSubtitle = document.querySelector('.intro-subtitle')
      var postIntros = document.querySelector('.post-intros')

      if (introTitle) introTitle.classList.add('intro-fade-in')
      if (introSubtitle) introSubtitle.classList.add('intro-fade-in')
      if (postIntros) postIntros.classList.add('post-fade-in')
    }

    if (document.fonts && document.fonts.load) {
      Promise.race([
        document.fonts.load('1em Oswald-Regular'),
        new Promise(function (resolve) {
          window.setTimeout(resolve, 2500)
        }),
      ]).then(revealIntro, revealIntro)
    } else {
      revealIntro()
    }
  })()
</script>
